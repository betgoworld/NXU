# ── Supabase ───────────────────────────────────────────────
# Projeto → Settings → API. A anon key é pública por design (RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA use a service role key neste projeto. Ela não é necessária.

# Segredo compartilhado entre o servidor Next.js e o banco (ver supabase/migrations: SETUP MANUAL).
# Sem ele, o RPC de cadastro não pode ser chamado do navegador. Gere com: openssl rand -hex 32
WAITLIST_API_SECRET=
# Sal para gerar hash do IP no rate limiting (o IP em si nunca é salvo). openssl rand -hex 16
RATE_LIMIT_SALT=

# ── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nxu.com.br
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/nxu
# Número que recebe a mensagem de confirmação (somente dígitos, com DDI). Vazio = botão oculto.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LANDING_VARIANT=a

# ── Contador (desativado por padrão) ──────────────────────
NEXT_PUBLIC_COUNTDOWN_ENABLED=false
# ISO 8601 com fuso, ex.: 2026-11-20T20:00:00-03:00
NEXT_PUBLIC_LAUNCH_DATE=

# ── Prova social (desativada por padrão) ──────────────────
SHOW_WAITLIST_COUNT=false
# Só exibe a contagem a partir deste número real de cadastros.
WAITLIST_COUNT_MIN=500
# Ajuste para cadastros reais coletados fora deste banco (ex.: lista importada de evento).
# Nunca use para inflar números. Valores negativos servem para descontar testes.
WAITLIST_COUNT_OFFSET=0

# ── Analytics (opcional) ──────────────────────────────────
NEXT_PUBLIC_GTM_ID=
